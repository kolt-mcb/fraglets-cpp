# Parallel Sort v2 - Simplified and working version
# Uses partition to create independent sorting tasks

# Entry: partition into N chunks and initiate sorting
[partition 4 sort 45 12 78 23 91 34 56 67 89 11 43 29 15 72 38 54]

# Sort each chunk (simple bubble sort for demonstration)
# [sort id elements...] - unimolecular, can run in parallel
[matchp sort nop]

# After all chunks are sorted, they need to be merged
# For now, just demonstrating that partition works

# Test the merge separately
[merge 1 3 5 7 9 * 2 4 6 8 10]
[merge -5 -3 -1 * -4 -2 0]

